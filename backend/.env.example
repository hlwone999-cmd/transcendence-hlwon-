# =============================================================
# Contoh konfigurasi backend Jurnal MT5 — SALIN jadi .env lalu isi.
# JANGAN pernah commit file .env berisi kredensial asli.
# =============================================================

# --- Provider MT5 ---
MT5_PROVIDER=mt5linux
# false = backend jalan normal tapi status "disconnected" (tidak crash).
MT5_ENABLED=false

# Alamat mt5server.exe (RPyC). WAJIB 127.0.0.1 — JANGAN buka ke publik.
MT5_HOST=127.0.0.1
MT5_PORT=18812

# Kredensial akun MT5 Exness (READ-ONLY: backend tidak pernah mengirim order).
# Simpan hanya di sini / secret storage. Tidak masuk log, APK, atau database.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Real

# --- Sinkronisasi ---
MT5_SYNC_INTERVAL_SECONDS=300
MT5_HISTORY_INITIAL_DAYS=90
# Overlap incremental (detik) agar deal yang baru tertulis di terminal
# dekat batas waktu tidak terlewat. Upsert by ticket mencegah duplikat.
MT5_SYNC_OVERLAP_SECONDS=86400

# --- API ---
# Token wajib untuk endpoint aplikasi (header X-API-Token).
# Generate: openssl rand -hex 32
API_TOKEN=
API_BIND=127.0.0.1
API_PORT=8000

# --- Database ---
JOURNAL_DB_PATH=data/journal.db

# --- Konfigurasi simbol (opsional, JSON) ---
# Override definisi pip per simbol. Default: pip_size = 10 * point
# (XAUUSD point 0.01 -> pip 0.1; EURUSD 5 digit -> 0.0001; JPY 3 digit -> 0.01).
# SYMBOL_CONFIG={"XAUUSD": {"pip_size": 0.1}}
