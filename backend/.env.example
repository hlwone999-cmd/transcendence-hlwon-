# =============================================================
# Contoh konfigurasi backend Jurnal MT5 — SALIN jadi .env lalu isi.
# JANGAN pernah commit file .env berisi kredensial asli.
# =============================================================

# --- Provider MT5 ---
MT5_PROVIDER=mt5linux
# false = backend jalan normal tapi status "disconnected" (tidak crash).
MT5_ENABLED=false

# Alamat mt5server.exe (RPyC). WAJIB 127.0.0.1 — JANGAN buka ke publik.
MT5_HOST=127.0.0.1
MT5_PORT=18812

# Kredensial akun MT5 Exness (READ-ONLY: backend tidak pernah mengirim order).
# Simpan hanya di sini / secret storage. Tidak masuk log, APK, atau database.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Real

# --- Sinkronisasi ---
MT5_SYNC_INTERVAL_SECONDS=300
MT5_HISTORY_INITIAL_DAYS=90
# Overlap incremental (detik) agar deal yang baru tertulis di terminal
# dekat batas waktu tidak terlewat. Upsert by ticket mencegah duplikat.
MT5_SYNC_OVERLAP_SECONDS=86400

# --- API ---
# Token wajib untuk endpoint aplikasi (header X-API-Token).
# Generate: openssl rand -hex 32
API_TOKEN=
API_BIND=127.0.0.1
API_PORT=8000

# --- Database ---
JOURNAL_DB_PATH=data/journal.db

# --- Konfigurasi simbol (opsional, JSON) ---
# Override definisi pip per simbol. Default: pip_size = 10 * point
# (XAUUSD point 0.01 -> pip 0.1; EURUSD 5 digit -> 0.0001; JPY 3 digit -> 0.01).
# SYMBOL_CONFIG={"XAUUSD": {"pip_size": 0.1}}

# =============================================================
# MULTI-CUSTOMER MVP (PostgreSQL) — baru
# =============================================================

# --- Database produksi (WAJIB di VPS) ---
# Jika diisi, engine PostgreSQL dipakai (kosong = SQLite dev/test).
DATABASE_URL=postgresql://transcendence:GANTI_PASSWORD@127.0.0.1:5432/transcendence

# --- Kunci enkripsi kredensial MT5 (WAJIB utk bind akun) ---
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TIDAK boleh ada di repo/database. Simpan di secret manager/env saja.
MT5_CRED_KEY=
# Opsional: kunci lama saat rotasi (hanya untuk dekripsi).
MT5_CRED_KEY_OLD=

# --- Auth customer ---
AUTH_TOKEN_TTL_HOURS=168        # 7 hari
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_SECONDS=900
MAX_CUSTOMERS=4                 # kapasitas MVP
# Registrasi portal publik (/auth/register) — AKTIF (keputusan produk #1).
# Registrasi TIDAK memakai slot MT5 (MAX_CUSTOMERS = slot terminal MT5).
# Dibatasi per IP klien tepercaya (jam/hari) & per subnet (hari), persisten
# di DB. MAX_REGISTERED_CUSTOMERS: batas akun PORTAL (rekomendasi 200;
# 0 = tanpa batas, tidak disarankan). Tidak berlaku utk self-link MT5.
AUTH_PUBLIC_REGISTER_ENABLED=1
MAX_REGISTERED_CUSTOMERS=200
REGISTER_PER_IP_HOUR=5
REGISTER_PER_IP_DAY=10
REGISTER_PER_SUBNET_DAY=30
# IP klien di balik nginx: header hanya dipercaya bila peer TCP ada di
# TRUSTED_PROXIES. nginx WAJIB: proxy_set_header X-Real-IP $remote_addr;
TRUSTED_PROXIES=127.0.0.1,::1
CLIENT_IP_HEADER=X-Real-IP
# Sync menolak sesi MT5 trade-capable (password MASTER). Jangan dimatikan.
MT5_ENFORCE_INVESTOR_READONLY=1
# Self-link /mt5/connect (redesign Jurnal MT5). Akun BARU hanya akun REAL
# (akun demo gratis tidak bisa menduduki slot kapasitas). Allowlist server
# opsional, pola fnmatch dipisah koma, mis. Exness-MT5Real*
MT5_SELF_LINK_ENABLED=1
MT5_SELF_LINK_REQUIRE_REAL=1
MT5_SELF_LINK_SERVER_ALLOWLIST=
MT5_VERIFY_TIMEOUT_SECONDS=12
# Auto-provisioning (docs/AUTO-PROVISIONING-MT5.md). Mode real memanggil
# helper privileged via `sudo -n` — API tidak pernah root.
MT5_PROVISION_TIMEOUT_SECONDS=120
MT5_CONNECT_SYNC_WAIT_SECONDS=10
PROVISIONER_HELPER=/usr/local/sbin/transcendence-mt5-provision
PROVISIONER_SUDO=/usr/bin/sudo
# Layanan RPC read-only bertoken (docs/RPYC-SECURITY.md) — MT5_PROVIDER=mt5ro
# MT5_RPC_SECRET=<openssl rand -hex 32>   (SECRET; samakan dgn helper)
# Mode RPC terminal BARU: classic (kompatibel) | ro (read-only bertoken).
# Terminal lama tidak berubah. Lihat docs/RPYC-SECURITY.md §6.
MT5_RPC_MODE_DEFAULT=classic

# --- Terminal MT5 per customer ---
RPYC_PORT_BASE=18812            # C001=18812 ... C004=18815 (localhost saja)
TERM_BASE_DIR=/var/lib/transcendence/terminals
TERMINAL_PROVISION_MODE=real    # real=VPS (Wine), mock=dev/test

# Token API global lama kini HANYA dipakai endpoint /api/v1/admin/*
# (bootstrap operasional). Endpoint data memakai token sesi customer.

# --- Perbaikan audit (2026-11) -------------------------------------------
# DATABASE_URL produksi WAJIB memakai role NON-OWNER agar RLS aktif
# (migrasi 002 membuat role + grant-nya; owner hanya untuk migrasi):
# DATABASE_URL=postgresql://transcendence_app:<PASSWORD_APP>@127.0.0.1:5432/transcendence
#
# Binary server RPyC per terminal (default: <terminal_dir>/mt5server.exe).
# CLI resmi rpyc-classic memakai SWITCH: --host <host> --port <port>
# (bukan argumen posisional); wrapper menambahkan keduanya otomatis dan
# host SELALU 127.0.0.1. Override hanya path/interpreternya, mis.:
# MT5SERVER_BIN=C:\python\python.exe -m mt5linux
